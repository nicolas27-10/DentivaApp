---
import { getSession } from "@/lib/auth";
import { supabase } from "@/lib/supabaseClient";

const user = await getSession(Astro.cookies);
const currentPath = Astro.url.pathname;
let avatarUrl: string | null = null;
let isPremium: boolean = false;
let isAdmin: boolean = false;

// Consulta combinada de Perfil (Avatar, Estado Premium y Rol)
if (user?.id) {
  const { data: profile } = await supabase
    .from("profiles")
    .select("avatar_url, is_premium, role")
    .eq("id", user.id)
    .single();

  avatarUrl = profile?.avatar_url ?? null;
  isPremium = profile?.is_premium ?? false;
  isAdmin = profile?.role === "admin";
}

const navLinks = [
  { 
    href: '/dashboard#fortschritt', 
    label: 'Fortschritt', 
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18 M7 16l4-4 4 4 4-6" />' 
  },
  { 
    href: '/dashboard#lernen', 
    label: 'Lernen', 
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>' 
  },
  { 
    href: '/dashboard#entrenamiento', 
    label: 'Trainingszentrum', 
    icon: '<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M15.5 13a3.5 3.5 0 0 0 -3.5 3.5v1a3.5 3.5 0 0 0 7 0v-1.8" /><path d="M8.5 13a3.5 3.5 0 0 1 3.5 3.5v1a3.5 3.5 0 0 1 -7 0v-1.8" /><path d="M17.5 16a3.5 3.5 0 0 0 0 -7h-.5" /><path d="M19 9.3v-2.8a3.5 3.5 0 0 0 -7 0" /><path d="M6.5 16a3.5 3.5 0 0 1 0 -7h.5" /><path d="M5 9.3v-2.8a3.5 3.5 0 0 1 7 0v10" /></svg>' 
  },
  { 
    href: '/dashboard#leaderboard', 
    label: 'Einstufung', 
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />' 
  },
];
---

<!-- Envoltorio Sticky que incluye el Banner + Nav para que nada se solape al hacer scroll -->
<header class="sticky top-0 z-50 w-full">

  {/* FRANJA DE PRUEBA / PROMO (Solo visible si el usuario NO es Premium) */}
  {!isPremium && (
    <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 text-white px-4 py-2 text-xs sm:text-sm font-medium shadow-inner flex items-center justify-center gap-2">
      <span class="bg-white/20 text-white text-[10px] sm:text-[12px] font-extrabold uppercase px-2 py-2 rounded-md">
        TEST-MODUS
      </span>
      <span class="hidden sm:inline">
        Sie befinden sich im Testmodus.
      </span>
      <span>
        Für uneingeschränkten Zugriff, 
        <a href="/pricing" class="underline font-bold hover:text-amber-100 transition-colors ml-1">
          abonnieren Sie hier →
        </a>
      </span>
    </div>
  )}

  <nav class="bg-white border-b-4 border-border/60">
    <div class="px-4 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity cursor-pointer">
          <img src="/DentivaLogo.png" alt="Dentiva" class="h-12 rounded-lg" />
        </a>

        <div class="hidden lg:flex items-center gap-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="nav-item flex items-center gap-2 px-4 py-2 rounded-xl text-[13px] font-bold transition-all text-textMain/60 hover:bg-slate-50 hover:text-textMain"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={link.icon} />
              {link.label}
            </a>
          ))}
        </div>

        <div class="flex items-center gap-4">
          <div class="relative group cursor-pointer">
            <div class="w-10 h-10 bg-[#E4F6FD] border-2 border-[#C0DFF0] rounded-full flex items-center justify-center text-[#3AAEDC]">
              {
                avatarUrl ? (
                  <img
                    src={avatarUrl}
                    alt="Profilbild"
                    class="h-full w-full rounded-full object-cover"
                  />
                ) : (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                )
              }
            </div>

            <!-- Menú Desplegable -->
            <div class="absolute right-0 mt-2 w-52 bg-white rounded-xl shadow-lg border border-border opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <div class="p-2 space-y-1">
                
                <!-- Info Usuario -->
                <div class="px-3 py-2 border-b border-border/70 mb-1">
                  <p class="text-[11px] text-textMain/50 uppercase tracking-wider font-semibold">Angemeldet als</p>
                  <p class="text-sm font-bold text-textMain truncate" title={user?.email}>{user?.email}</p>
                </div>

                <!-- OPCIÓN EXCLUSIVA PARA ADMINS -->
                {isAdmin && (
                  <a 
                    href="/admin" 
                    class="flex items-center gap-2 px-3 py-2 text-sm font-semibold text-accent hover:bg-accent/10 rounded-lg transition-colors"
                  >
                    <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    Admin Dashboard
                  </a>
                )}

                <!-- Enlace a Perfil -->
                <a 
                  href="/profile" 
                  class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-textMain/80 hover:text-textMain hover:bg-slate-50 rounded-lg transition-colors"
                >
                  <svg class="w-4 h-4 text-textMain/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  Mein Profil
                </a>
                
                <div class="border-t border-border/70 my-1"></div>

                <!-- Botón de Cerrar Sesión Directo (Sin form POST problemático) -->
                <button 
                  type="button" 
                  id="logout-btn"
                  class="flex items-center gap-2 w-full text-left px-3 py-2 text-sm font-medium text-error hover:bg-red-50 rounded-lg transition-colors cursor-pointer"
                >
                  <svg class="w-4 h-4 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  Abmelden
                </button>

              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  import { supabase } from '../lib/supabaseClient';

  function initScrollspy() {
    const navLinks = document.querySelectorAll('.nav-item');
    const sections = document.querySelectorAll('section[id]');

    const observerOptions = {
      root: null,
      rootMargin: '-100px 0px -60% 0px', 
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const currentId = entry.target.id;

          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href && href.endsWith(`#${currentId}`)) {
              link.classList.add('bg-[#E4F6FD]', 'text-[#1A8AB8]');
              link.classList.remove('text-textMain/60', 'hover:bg-slate-50', 'hover:text-textMain');
            } else {
              link.classList.remove('bg-[#E4F6FD]', 'text-[#1A8AB8]');
              link.classList.add('text-textMain/60', 'hover:bg-slate-50', 'hover:text-textMain');
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  }

  function initLogout() {
    const logoutBtn = document.getElementById('logout-btn');
    
    if (logoutBtn) {
      logoutBtn.onclick = async (e) => {
        e.preventDefault();
        
        try {
          // 1. Cerramos la sesión en el cliente de Supabase
          await supabase.auth.signOut();
        } catch (err) {
          console.error("Error cerrando sesión en Supabase:", err);
        }
        
        // 2. Eliminamos las cookies de sesión
        document.cookie = 'sb-access-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'sb-refresh-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
        
        // 3. Redirigimos de forma limpia e instantánea al login
        window.location.replace('/login');
      };
    }
  }

  document.addEventListener('astro:page-load', () => {
    initScrollspy();
    initLogout();
  });
  
  // Ejecución inicial directa
  initScrollspy();
  initLogout();
</script>
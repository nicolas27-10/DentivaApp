---
import AuthLayout from '../layouts/AuthLayout.astro';
import { signUp } from '../lib/auth';
import { getSession } from "../lib/auth";
import NationalitySelect from '../components/NationalitySelect.astro';

const session = await getSession(Astro.cookies);

if (session) {
  return Astro.redirect("/dashboard");
}

let errorMessage: string | null = null;
let successMessage: string | null = null;

if (Astro.request.method === 'POST') {
  const contentType = Astro.request.headers.get('content-type') ?? '';

  if (
    !contentType.includes('application/x-www-form-urlencoded') &&
    !contentType.includes('multipart/form-data')
  ) {
    errorMessage = 'Das Formular konnte nicht verarbeitet werden.';
  } else {
    const formData = await Astro.request.formData();
    const firstName = String(formData.get('first_name') ?? '').trim();
    const lastName = String(formData.get('last_name') ?? '').trim();
    const email = String(formData.get('email') ?? '').trim();
    const password = String(formData.get('password') ?? '');
    const nationality = String(formData.get('nationality') ?? '').trim();

    if (!firstName || !lastName || !email || !password || !nationality) {
      errorMessage = 'Bitte füllen Sie alle Felder aus.';
    } else if (password.length < 6) {
      errorMessage = 'Das Passwort muss mindestens 6 Zeichen lang sein.';
    } else {
      const { error: signUpError } = await signUp(email, password, { 
        first_name: firstName, 
        last_name: lastName, 
        nationality: nationality 
      });

      if (signUpError) {
        errorMessage = signUpError.message ?? 'Das Konto konnte nicht erstellt werden.';
      } else {
        successMessage = 'success';
      }
    }
  }
}
---

<AuthLayout title="Registrieren - Dentiva">
  
  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fadeIn 0.6s ease-out forwards; }

    /* Oculta los controles nativos que se sobreponen tras el autocompletado */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
      display: none !important;
    }
  </style>

  {successMessage ? (
    <!-- VISTA DE ÉXITO -->
    <div class="animate-fade-in text-center p-8 bg-card border border-border rounded-2xl shadow-lg">
      <div class="w-16 h-16 bg-success/20 text-success rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <h2 class="text-2xl font-bold text-textMain mb-2">Fast geschafft!</h2>
      <p class="text-textMain/70 mb-4 max-w-sm mx-auto">
        Wir haben Ihnen eine Bestätigungs-E-Mail gesendet. Bitte klicken Sie auf den Link in der E-Mail, um Ihre Registrierung abzuschließen.
      </p>

      <!-- AVISO DE CARPETA SPAM -->
      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm text-blue-800 text-left">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <p class="font-bold mb-1">E-Mail nicht erhalten?</p>
            <p class="text-blue-700/90">
              Bitte überprüfe auch deinen Spam-Ordner. Da Dentiva eine neue Plattform ist, landen unsere ersten E-Mails manchmal dort.
            </p>
          </div>
        </div>
      </div>

    </div>
  ) : (
    <!-- VISTA DEL FORMULARIO -->
    <div class="animate-fade-in">
      <h1 class="text-2xl font-bold text-textMain mb-6">Konto erstellen</h1>

      {errorMessage && (
        <p class="mb-4 text-sm text-error bg-error/10 border border-error/30 rounded-lg px-4 py-3">
          {errorMessage}
        </p>
      )}

      <form class="space-y-4" method="post" action="/register">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="first_name" class="block text-sm font-medium text-textMain/80 mb-1">Vorname</label>
            <input type="text" id="first_name" name="first_name" required class="w-full px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary bg-card text-textMain" placeholder="Max" />
          </div>
          <div>
            <label for="last_name" class="block text-sm font-medium text-textMain/80 mb-1">Nachname</label>
            <input type="text" id="last_name" name="last_name" required class="w-full px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary bg-card text-textMain" placeholder="Mustermann" />
          </div>
        </div>

        <div>
          <label for="nationality" class="block text-sm font-medium text-textMain/80 mb-1">
            Nationalität
          </label>
          <NationalitySelect />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-textMain/80 mb-1">E-Mail</label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary bg-card text-textMain" placeholder="deine@email.de" />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-textMain/80 mb-1">Passwort</label>
          <div class="relative flex items-center">
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              minlength="6" 
              class="w-full px-4 py-2 pr-12 border border-border rounded-lg focus:ring-2 focus:ring-primary bg-card text-textMain relative z-0" 
              placeholder="Mindestens 6 Zeichen" 
            />
            <button 
              type="button" 
              class="toggle-password absolute right-2 top-1/2 -translate-y-1/2 p-2 flex items-center text-textMain/40 hover:text-textMain/70 transition-colors focus:outline-none z-30 cursor-pointer" 
              data-target="password"
              aria-label="Passwort anzeigen"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 pointer-events-none">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="w-full py-3 px-4 bg-accent hover:bg-accent/90 text-white font-medium rounded-lg transition-colors">Registrieren</button>
      </form>

      <!-- ENLACE AL LOGIN -->
      <p class="mt-4 text-sm text-center text-textMain/70">
        Hast du bereits ein Konto? <a href="/login" class="text-primary hover:underline">Hier einloggen</a>
      </p>

    </div>
  )}

</AuthLayout>

<script>
  function toggleInputVisibility(button: HTMLButtonElement) {
    const targetId = button.getAttribute('data-target');
    if (!targetId) return;

    const input = document.getElementById(targetId) as HTMLInputElement | null;
    if (!input) return;

    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    button.style.color = isPassword ? '#4AAED9' : '';
  }

  // Captura el toque en móvil o clic en desktop antes de cualquier menú nativo
  document.addEventListener('pointerdown', (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest('.toggle-password') as HTMLButtonElement | null;
    if (btn) {
      e.preventDefault();
      toggleInputVisibility(btn);
    }
  });
</script>
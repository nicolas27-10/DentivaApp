---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import UnitCard from "../components/UnitCard.astro";
import LeaderboardTable from "../components/LeaderboardTable.astro";
import { getModulesWithProgress } from "@/lib/modules";
import { supabase } from "@/lib/supabaseClient";
import GeneralProgress from "../components/GeneralProgress";
import DashboardTrainingSection from "@/components/DashboardTrainingSection";
import UpdateModal from "@/components/UpdateModal";

if (Astro.request.method === "POST") {
  Astro.cookies.delete("sb-access-token", { path: "/" });
  Astro.cookies.delete("sb-refresh-token", { path: "/" });
  return Astro.redirect("/login");
}

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) return Astro.redirect("/login");

const { data: authData, error: authError } = await supabase.auth.getUser(
  accessToken.value,
);
if (authError || !authData?.user) {
  Astro.cookies.delete("sb-access-token", { path: "/" });
  Astro.cookies.delete("sb-refresh-token", { path: "/" });
  return Astro.redirect("/login");
}

const user = authData.user;
const userId = user.id;

// 1. Obtener perfil para los datos visuales de bienvenida (Nombre y Puntos FSP)
const { data: profile } = await supabase
  .from("profiles")
  .select("total_fsp_points, first_name, is_premium")
  .eq("id", userId)
  .single();

// 2. Obtener módulos (La función getModulesWithProgress YA se encarga de revisar si es Premium y bloquear)
const modules = await getModulesWithProgress(userId, Astro.cookies);

// 3. --- CÁLCULO DINÁMICO DE INSIGNIAS (ABZEICHEN) ---
const token = accessToken.value;
let completedBadgesCount = 0;

// Obtener todos los ejercicios válidos (excluyendo 'multiple_choice')
const { data: allExercises } = await supabase
  .from("exercises")
  .select("id, lesson_id")
  .neq("type", "multiple_choice")
  .setHeader('Authorization', `Bearer ${token}`);

const exerciseIds = allExercises?.map((e) => e.id) || [];

if (userId && exerciseIds.length > 0) {
  // Obtener los intentos guardados del usuario
  const { data: attempts } = await supabase
    .from("user_attempts")
    .select("exercise_id")
    .eq("user_id", userId)
    .in("exercise_id", exerciseIds)
    .setHeader('Authorization', `Bearer ${token}`);

  const attemptedExerciseIds = new Set(attempts?.map((a) => a.exercise_id));

  // Agrupar ejercicios por cada lección
  const exercisesByLesson = new Map<string, string[]>();
  allExercises?.forEach((e) => {
    if (!exercisesByLesson.has(e.lesson_id)) {
      exercisesByLesson.set(e.lesson_id, []);
    }
    exercisesByLesson.get(e.lesson_id)?.push(e.id);
  });

  // Evaluar cuáles lecciones tienen sus ejercicios al 100%
  exercisesByLesson.forEach((exercisesInLesson) => {
    const totalInLesson = exercisesInLesson.length;
    const completedInLesson = exercisesInLesson.filter((id) =>
      attemptedExerciseIds.has(id),
    ).length;

    if (totalInLesson > 0 && completedInLesson === totalInLesson) {
      completedBadgesCount++;
    }
  });
}

// 4. Preparar variables para la UI
const isPremium = profile?.is_premium ?? false;
const firstName = profile?.first_name || "Student";
const fspPercentage = Math.min(
  Math.round((profile?.total_fsp_points || 0) / 10),
  100,
);
---

<DashboardLayout title="Dashboard - Dentiva">
  <section id="fortschritt" class={`mb-12 ${!isPremium ? 'scroll-mt-36' : 'scroll-mt-24'}`}>
    <div
      class="bg-card border border-border rounded-3xl p-6 lg:p-8 flex flex-col lg:flex-row gap-8 justify-between items-center shadow-md"
    >
      <div class="w-full lg:w-1/3 text-center lg:text-left min-w-0">
        <h1 class="text-3xl font-extrabold text-textMain mb-1 truncate">
          Hallo, <span class="capitalize">{firstName}</span>
        </h1>
        <p class="text-textMain/60 text-sm font-medium">
          Weiter so — die FSP rückt immer näher!
        </p>
      </div>

      <div class="w-full lg:w-2/5 space-y-5">
        <GeneralProgress
          client:load
          userId={userId}
          accessToken={accessToken.value}
        />
        <div>
          <div
            class="flex justify-between text-xs font-bold text-textMain mb-2 tracking-wide uppercase"
          >
            <span>FSP-VORBEREITUNG</span>
            <span class="text-[#20B273]">{fspPercentage}%</span>
          </div>
          <div class="h-3 w-full bg-green-100 rounded-full overflow-hidden">
            <div
              class="h-full bg-[#20B273] transition-all duration-1000 ease-out rounded-full"
              style={`width: ${fspPercentage}%`}
            >
            </div>
          </div>
        </div>
      </div>

      <div class="w-full lg:w-1/3 flex">
        <!-- Tarjeta Prominente de Insignias con Conteo Dinámico -->
        <div
          class="flex-1 flex flex-col items-center justify-center bg-gradient-to-b from-slate-50 to-slate-100 border border-slate-200 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow"
        >
          <!-- Contenedor del Icono -->
          <div
            class="bg-amber-100 p-3 rounded-full text-amber-500 mb-3 shadow-inner"
          >
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>

          <!-- Textos Dinámicos -->
          <div class="text-center">
            <span class="block text-4xl font-bold text-slate-800 mb-1">
              {completedBadgesCount}
            </span>
            <span
              class="text-sm font-bold text-slate-500 uppercase tracking-widest"
            >
              Abzeichen
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="lernen" class={`mb-12 ${!isPremium ? 'scroll-mt-36' : 'scroll-mt-24'}`}>
    <h2
      class="text-lg font-semibold text-textMain mb-4 flex items-center gap-2 uppercase tracking-widest"
    >
      <svg
        class="w-6 h-6 text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
        ></path>
      </svg>
      Lernmodule
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        modules.map((module) => (
          <UnitCard
            id={module.id}
            title={module.title}
            description={module.description}
            progress={module.userProgress?.progress_percentage || 0}
            isLocked={module.isLocked}
            lockReason={module.lockReason}
            dbTotal={module.total_exercises} // 👈 ¡NUEVO!
            dbCompleted={module.completed_exercises} // 👈 ¡NUEVO!
          />
        ))
      }
    </div>
  </section>

  <DashboardTrainingSection isPremium={isPremium} />

  <section id="leaderboard" class={`mb-12 ${!isPremium ? 'scroll-mt-36' : 'scroll-mt-24'}`}>
    <h2
      class="text-lg font-semibold text-textMain mb-4 flex items-center gap-2 uppercase tracking-widest"
    >
      <svg
        class="w-6 h-6 text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
        ></path>
      </svg>
      Wöchentliches Ranking
    </h2>
    <LeaderboardTable />
    <UpdateModal client:only="react"/>
  </section>

  {/* --- SCRIPT GLOBAL DE PROGRESO EN DASHBOARD (MODO DEBUG) --- */}
  <script define:vars={{ userId }}>
    const syncDashboardProgress = () => {
      console.log("🔍 Iniciando escaneo de progreso local en el Dashboard...");
      const moduleCards = document.querySelectorAll('.module-card');
      
      moduleCards.forEach(card => {
        const moduleId = card.getAttribute('data-module-id');
        const dbTotal = parseInt(card.getAttribute('data-db-total') || '0', 10);
        let dbCompleted = parseInt(card.getAttribute('data-db-completed') || '0', 10);
        
        console.log(`📦 Módulo ${moduleId} -> Total DB: ${dbTotal} | Completados DB: ${dbCompleted}`);

        if (dbTotal === 0) {
          console.warn(`⚠️ Módulo ${moduleId} ignorado: El total de ejercicios es 0. ¿Falta en getModulesWithProgress?`);
          return;
        }

        let localBonus = 0;
        const prefix = `dentiva_progress_${userId}_m${moduleId}_l`;
        
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith(prefix)) {
            try {
              const parsed = JSON.parse(localStorage.getItem(key));
              localBonus += Object.keys(parsed).length;
            } catch(e) {}
          }
        }

        console.log(`✅ Módulo ${moduleId} -> Respuestas locales encontradas: ${localBonus}`);

        if (localBonus > 0) {
          const totalCompleted = Math.min(dbCompleted + localBonus, dbTotal);
          const currentPercentage = Math.round((totalCompleted / dbTotal) * 100);

          const progressText = card.querySelector('.progress-text');
          if (progressText && currentPercentage < 100) { 
            progressText.innerText = `${currentPercentage}%`;
          }

          const progressBar = card.querySelector('.progress-bar');
          if (progressBar && currentPercentage < 100) {
            progressBar.style.width = `${currentPercentage}%`;
            progressBar.classList.remove('bg-primary'); 
            progressBar.classList.add('bg-amber-400');
          }
        }
      });
    };

    syncDashboardProgress();
    document.addEventListener('DOMContentLoaded', syncDashboardProgress);
    document.addEventListener('astro:page-load', syncDashboardProgress);
  </script>
</DashboardLayout>
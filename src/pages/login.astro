---
import AuthLayout from '../layouts/AuthLayout.astro';
import { signIn } from '../lib/auth';
import { getSession } from "../lib/auth";

const session = await getSession(Astro.cookies);

if (session) {
  return Astro.redirect("/dashboard");
}

let errorMessage: string | null = null;
let successMessage: string | null = null;

if (Astro.request.method === 'POST') {
  const contentType = Astro.request.headers.get('content-type') ?? '';

  if (
    !contentType.includes('application/x-www-form-urlencoded') &&
    !contentType.includes('multipart/form-data')
  ) {
    errorMessage = 'Das Formular konnte nicht verarbeitet werden (ungültiger Content-Type).';
  } else {
    const formData = await Astro.request.formData();
    const { error } = await signIn(formData, Astro.cookies);
    if (error) {
      errorMessage = error.message ?? 'Wir konnten uns nicht einloggen.';
    } else {
      successMessage = 'Anmeldung erfolgreich.';
      return Astro.redirect('/dashboard');
    }
  }
}
---

<AuthLayout title="Login - Dentiva">
  <style>
    /* Oculta los iconos nativos del navegador que interfieren con el botón */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
      display: none !important;
    }
  </style>

  <h1 class="text-2xl font-bold text-textMain mb-6">Login</h1>
  
  <form class="space-y-4" method="post" action="/login" enctype="multipart/form-data">
    {errorMessage && (
      <p class="mb-4 text-sm text-error bg-error/10 border border-error/30 rounded-lg px-4 py-3">
        {errorMessage}
      </p>
    )}
    {successMessage && (
      <p class="mb-4 text-sm text-success bg-success/10 border border-success/30 rounded-lg px-4 py-3">
        {successMessage}
      </p>
    )}
    
    <div>
      <label for="email" class="block text-sm font-medium text-textMain/80 mb-1">
        E-Mail-Adresse
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary focus:border-primary bg-card text-textMain"
        placeholder="deine@email.de"
      />
    </div>
    
    <div>
      <label for="password" class="block text-sm font-medium text-textMain/80 mb-1">
        Passwort
      </label>
      <div class="relative flex items-center">
        <input
          type="password"
          id="password"
          name="password"
          required
          minlength="6"
          class="w-full px-4 py-2 pr-12 border border-border rounded-lg focus:ring-2 focus:ring-primary focus:border-primary bg-card text-textMain relative z-0"
          placeholder="Mindestens 6 Zeichen"
        />
        <button
          type="button"
          class="toggle-password absolute right-2 top-1/2 -translate-y-1/2 p-2 flex items-center text-textMain/40 hover:text-textMain/70 transition-colors focus:outline-none z-30 cursor-pointer"
          data-target="password"
          aria-label="Passwort anzeigen"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 pointer-events-none">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </button>
      </div>
    </div>

    <button
      type="submit"
      class="w-full py-3 px-4 bg-accent hover:bg-accent/90 text-white font-medium rounded-lg transition-colors"
    >
      Login
    </button>
  </form>

  <p class="mt-4 text-sm text-textMain/70">
    Hast du noch kein Konto? <a href="/register" class="text-primary hover:underline">Melde dich jetzt an</a>
  </p>
</AuthLayout>

<script>
  function toggleInputVisibility(button: HTMLButtonElement) {
    const targetId = button.getAttribute('data-target');
    if (!targetId) return;

    const input = document.getElementById(targetId) as HTMLInputElement | null;
    if (!input) return;

    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    button.style.color = isPassword ? '#4AAED9' : '';
  }

  // Captura el toque en móvil o clic en desktop antes de cualquier menú nativo
  document.addEventListener('pointerdown', (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest('.toggle-password') as HTMLButtonElement | null;
    if (btn) {
      e.preventDefault();
      toggleInputVisibility(btn);
    }
  });
</script>
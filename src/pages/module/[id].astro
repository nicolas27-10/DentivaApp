---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { supabase } from "../../lib/supabaseClient";
import { getSession } from '@/lib/auth';

export const prerender = false;

const { id } = Astro.params;

// 1. Obtener el usuario actual desde nuestra función segura
const user = await getSession(Astro.cookies);

// 🛑 GUARDIA: Si no hay usuario, lo mandamos al login
if (!user) {
  return Astro.redirect('/login');
}

const userId = user.id;

// 🔑 EXTRAER EL TOKEN PARA LAS CONSULTAS
const token = Astro.cookies.get('sb-access-token')?.value;

// 2. Obtener la información del Módulo (¡Con Token!)
const { data: moduleData } = await supabase
  .from("modules")
  .select("*")
  .eq("id", id)
  .single()
  .setHeader('Authorization', `Bearer ${token}`);

if (!moduleData) {
  return Astro.redirect('/dashboard');
}

// 3. Obtener TODAS las lecciones de este módulo (¡Con Token!)
const { data: lessons } = await supabase
  .from("lessons")
  .select("*")
  .eq("module_id", id)
  .order("order_index", { ascending: true })
  .setHeader('Authorization', `Bearer ${token}`);

// --- NUEVA LÓGICA DE PROGRESO ---
const lessonIds = lessons?.map(l => l.id) || [];

// 4. Obtener todos los ejercicios de estas lecciones (¡Con Token!)
const { data: allExercises } = await supabase
  .from("exercises")
  .select("id, lesson_id")
  .in("lesson_id", lessonIds)
  .neq("type", "multiple_choice") 
  .setHeader('Authorization', `Bearer ${token}`);

// 5. Obtener los intentos del usuario (¡Con Token!)
const exerciseIds = allExercises?.map(e => String(e.id)) || [];
let attemptedExerciseIds = new Set();

if (userId && exerciseIds.length > 0) {
  const { data: attempts } = await supabase
    .from("user_attempts")
    .select("exercise_id")
    .eq("user_id", userId)
    .in("exercise_id", exerciseIds)
    .setHeader('Authorization', `Bearer ${token}`);
  
  attemptedExerciseIds = new Set(attempts?.map(a => String(a.exercise_id)));
}

// 6. Combinar datos: Calcular progreso por cada lección
const lessonsWithProgress = lessons?.map(lesson => {
  // 👈 Forzamos String() para evitar errores de comparación
  const lessonExercises = allExercises?.filter(e => String(e.lesson_id) === String(lesson.id)) || [];
  const total = lessonExercises.length;
  const completed = lessonExercises.filter(e => attemptedExerciseIds.has(String(e.id))).length;
  const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;
  
  return { ...lesson, total, completed, percentage };
}) || [];
---

<DashboardLayout title={`Modul: ${moduleData.title}`}>
  
  <div class="mb-6">
    <a href="/dashboard" class="text-primary hover:underline text-sm font-medium">
      &larr; Zurück zum Dashboard
    </a>
  </div>

  <div class="bg-card p-8 rounded-2xl border-2 border-border shadow-md mb-8">
    <h1 class="text-3xl font-bold mb-2 text-textMain flex gap-2">
      <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      {moduleData.title}
    </h1>
    </div>

  <h2 class="text-2xl font-bold mb-6 text-textMain">Lehren aus diesem Modul</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {lessonsWithProgress.map((lesson) => (
      <a 
        href={`/lesson/${lesson.id}`}
        data-lesson-id={lesson.id}
        data-total={lesson.total}
        class="lesson-card flex flex-col h-full bg-card border-2 border-border rounded-xl p-6 hover:border-primary hover:shadow-md transition-all group relative overflow-hidden"
      >
        {lesson.percentage === 100 && (
          <div class="absolute inset-0 bg-green-50/30 pointer-events-none"></div>
        )}

        <div class="flex-grow relative z-10">
          <div class="flex justify-between items-start mb-2">
            <span class="text-xs font-bold text-primary uppercase tracking-wider block">
              Lektion {moduleData.order_index}.{lesson.order_index}
            </span>
            {lesson.percentage === 100 && (
              <div class="bg-amber-100 p-3 rounded-full text-amber-500 mb-3 shadow-inner">
                  <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                    <path
                      d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                    ></path>
                  </svg>
              </div>
            )}
          </div>
          
          <h3 class="text-lg font-bold text-textMain mb-3 group-hover:text-primary transition-colors">
            {lesson.title}
          </h3>
          <p class="text-sm text-textMain/70 line-clamp-2 mb-4">
            {lesson.content}
          </p>

          <div class="mt-auto">
            <div class="flex justify-between text-xs font-medium text-textMain/60 mb-1">
              <span>Fortschritt</span>
              <span class="progress-text">{lesson.percentage}%</span>
            </div>
            <div class="h-1.5 w-full bg-border rounded-full overflow-hidden">
              <div 
                class={`progress-bar h-full transition-all duration-500 ${lesson.percentage === 100 ? 'bg-green-500' : 'bg-primary'}`}
                style={`width: ${lesson.percentage}%`}
              ></div>
            </div>
          </div>
        </div>
        
        <div class="mt-6 pt-4 border-t border-border flex items-center justify-between text-sm font-medium text-primary relative z-10">
          <span class="action-text">{lesson.percentage === 100 ? 'Lektion wiederholen' : lesson.percentage > 0 ? 'Setzen Sie die Lektion fort' : 'Betreten Sie die Lektion'}</span>
          <span class="transform group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    ))}
  </div>

  {lessonsWithProgress.length === 0 && (
    <div class="text-center p-8 border border-border rounded-xl bg-card">
      <p class="text-textMain/60">Für dieses Modul wurden noch keine Lektionen erstellt.</p>
    </div>
  )}

  {/* --- SCRIPT PARA LEER BORRADORES LOCALES --- */}
  <script define:vars={{ userId, moduleId: id }}>
    const checkLocalProgress = () => {
      const lessonCards = document.querySelectorAll('.lesson-card');
      
      lessonCards.forEach(card => {
        const lessonId = card.getAttribute('data-lesson-id');
        const totalQuestions = parseInt(card.getAttribute('data-total'), 10);
        
        // 👈 Aquí usamos la nueva llave exacta
        const storageKey = `dentiva_progress_${userId}_m${moduleId}_l${lessonId}`;
        const savedProgress = localStorage.getItem(storageKey);
        
        if (savedProgress && totalQuestions > 0) {
          try {
            const parsed = JSON.parse(savedProgress);
            const answeredCount = Object.keys(parsed).length;
            
            if (answeredCount > 0) {
              const actionTextSpan = card.querySelector('.action-text');
              
              if (actionTextSpan && !actionTextSpan.textContent.includes('wiederholen')) {
                const localPercentage = Math.round((answeredCount / totalQuestions) * 100);
                
                actionTextSpan.innerHTML = 'Fortsetzen ⏳';
                actionTextSpan.style.color = '#F59E0B'; 
                
                const progressText = card.querySelector('.progress-text');
                if (progressText) progressText.innerText = `${localPercentage}%`;
                
                const progressBar = card.querySelector('.progress-bar');
                if (progressBar) {
                  progressBar.style.width = `${localPercentage}%`;
                  progressBar.classList.remove('bg-primary'); 
                  progressBar.classList.add('bg-amber-400'); 
                }
              }
            }
          } catch(e) {}
        }
      });
    };

    // Ejecutar inmediatamente
    checkLocalProgress();
    // Ejecutar en navegación estándar
    document.addEventListener('DOMContentLoaded', checkLocalProgress);
    // Ejecutar en navegación de Astro (View Transitions)
    document.addEventListener('astro:page-load', checkLocalProgress);
  </script>
</DashboardLayout>
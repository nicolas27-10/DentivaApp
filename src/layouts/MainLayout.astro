---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

// Valores por defecto si no se le pasa nada al Layout
const { 
  title = "Dentiva - Bildungsplattform für Zahnärzte", 
  description = "Bildungsplattform für Zahnärzte, die ihren Berufsabschluss in Deutschland anerkennen lassen möchten.",
  image = "/og-dentiva.jpg" // 👈 Explicación abajo
} = Astro.props;

// Construimos la URL completa para evitar enlaces relativos al compartir
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Icons & Fonts -->
    <link rel="icon" type="image/png" sizes="32x32" href="/DentivaLogoSm.png" />
    <link rel="apple-touch-icon" href="/DentivaLogoSm.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <meta name="theme-color" content="#4AAED9" />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-textMain">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <div 
      id="global-loader" 
      class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-white/60 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
    >
      <div class="relative w-16 h-16">
        <div class="absolute inset-0 border-4 border-[#E4F6FD] rounded-full"></div>
        <div class="absolute inset-0 border-4 border-[#2B8EB5] rounded-full border-t-transparent animate-spin"></div>
      </div>
      <p class="mt-4 text-[#2B8EB5] font-bold text-sm tracking-widest animate-pulse uppercase">
        Wird geladen...
      </p>
    </div>

    <script is:inline>
      document.addEventListener('astro:before-preparation', () => {
        const loader = document.getElementById('global-loader');
        if (loader) {
          loader.classList.remove('opacity-0', 'pointer-events-none');
          loader.classList.add('opacity-100');
        }
      });

      document.addEventListener('astro:after-swap', () => {
        const loader = document.getElementById('global-loader');
        if (loader) {
          loader.classList.remove('opacity-100');
          loader.classList.add('opacity-0', 'pointer-events-none');
        }
      });
    </script>
  </body>
</html>

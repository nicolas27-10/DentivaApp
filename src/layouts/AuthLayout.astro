---
interface Props {
  title?: string;
}

const { title = 'Dentiva' } = Astro.props;
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
---

<!doctype html>
<html lang="de">
  <head>
    <ClientRouter/>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/DentivaLogoSm.png" />
    <link rel="apple-touch-icon" href="/DentivaLogoSm.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <meta name="theme-color" content="#4AAED9" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col items-center justify-center bg-background text-textMain mx-4 py-4">
    <a href="/" class="block text-center text-2xl font-bold text-primary mb-8">
      <img class="sm:h-28 h-20 border-box transition-all" src="/DentivaLogo.png" alt="Dentiva" />
    </a>
    <div class="w-full max-w-md">
      <main class="bg-card rounded-lg shadow-md sm:p-8 p-4 border border-border">
        <slot />
      </main>
      <p class="text-center text-sm text-textMain/70 mt-6">
        <a href="/" class="hover:text-primary">← Zurück nach oben</a>
      </p>
    </div>

    <div 
      id="global-loader" 
      class="fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-white/60 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
    >
      <div class="relative w-16 h-16">
        <div class="absolute inset-0 border-4 border-[#E4F6FD] rounded-full"></div>
        <div class="absolute inset-0 border-4 border-[#2B8EB5] rounded-full border-t-transparent animate-spin"></div>
      </div>
      <p class="mt-4 text-[#2B8EB5] font-bold text-sm tracking-widest animate-pulse uppercase">
        Wird geladen...
      </p>
    </div>

    <script is:inline>
      document.addEventListener('astro:before-preparation', () => {
        const loader = document.getElementById('global-loader');
        if (loader) {
          loader.classList.remove('opacity-0', 'pointer-events-none');
          loader.classList.add('opacity-100');
        }
      });

      document.addEventListener('astro:after-swap', () => {
        const loader = document.getElementById('global-loader');
        if (loader) {
          loader.classList.remove('opacity-100');
          loader.classList.add('opacity-0', 'pointer-events-none');
        }
      });
    </script>

    <!-- Script del Puente de Autenticación y Redirección -->
    <script>
      import { supabase } from '../lib/supabaseClient';

      function setupAuthBridge() {
        const hash = window.location.hash;
        const path = window.location.pathname;
        const loader = document.getElementById('global-loader');

        // Función para mostrar tu animación de carga
        const showLoader = () => {
          if (loader) {
            loader.classList.remove('opacity-0', 'pointer-events-none');
            loader.classList.add('opacity-100');
          }
        };

        // 1. Si la URL trae un código de correo, mostramos el loader INMEDIATAMENTE
        if (hash.includes('access_token') || hash.includes('type=signup')) {
          showLoader();
        }

        const handleSession = (session: any) => {
          if (!session) return;
          
          // Guardamos las cookies para Astro
          document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=31536000; SameSite=Lax`;
          document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=31536000; SameSite=Lax`;

          // Si está en ruta pública, activamos el loader y redirigimos
          if (path === '/' || path === '/login' || path === '/register') {
            showLoader();
            window.location.replace('/dashboard');
          }
        };

        // 2. Escuchamos mientras Supabase procesa silenciosamente el código del correo
        supabase.auth.onAuthStateChange((event, session) => {
          if (session && (event === 'SIGNED_IN' || event === 'INITIAL_SESSION')) {
            handleSession(session);
          }
        });

        // 3. Revisión inicial proactiva (por si navega directamente ya estando logueado)
        supabase.auth.getSession().then(({ data }) => {
          if (data.session) handleSession(data.session);
        });
      }

      document.addEventListener('astro:page-load', setupAuthBridge);
      setupAuthBridge();
    </script>
  </body>
</html>
